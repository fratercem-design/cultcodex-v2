# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# bun.lock is parked, not adopted: Vercel picks its install command from the
# lockfile present in git, so committing this would silently switch the
# production build npm -> bun. Remove this line only as a deliberate migration.
bun.lock
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment — ignore ALL env files, allow only the checked-in template
.env*
!.env.example

# DB dumps (never commit — 642MB railway.dump bloated history once)
dbmigrate/

# Prisma
prisma/migrations/**/migration_lock.toml

# IDE
.idea/
.vscode/
*.swp

# OS
Thumbs.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Python
__pycache__/
*.py[cod]

# Local runtime artefacts for data-ingest / ASR pipelines
scripts/*.log
# Cookie jars (Netscape format, for yt-dlp/curl) hold live session credentials.
# Globbed, not an exact path: scripts/cookies.txt alone left cookies.master.txt
# untracked-but-committable.
scripts/cookies*.txt
scripts/asr-pending.json
scripts/remaining-episodes.json
scripts/_download-list.json
scripts/enrich/*.log
scripts/enrich/run-log.txt

# Claude Code config — track shared hook + settings, keep local overrides private
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json

# Brainstorming visual companion (superpowers skill)
.superpowers/
__pycache__/

# Psychenomicon art runner runtime artifacts
scripts/psychenomicon-art/daemon.lock
scripts/psychenomicon-art/daemon.log
scripts/psychenomicon-art/run-batch.log
scripts/psychenomicon-art/output/STOP

.vercel
.env*

# cron/sync logs � committed once by mistake, ignored since
logs/
modify_schema.py
prisma/*.bak
prisma/migrations.backup/
