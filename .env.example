# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/cultcodex_v2?schema=public"

# ─── YouTube ingest ──────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_google_api_key_here
YOUTUBE_CHANNEL_HANDLE=@CultofPsyche

# Supadata — third-party transcript API used by /api/admin/sync-transcripts to
# bypass YouTube's datacenter-IP blocking. Sign up at supadata.ai.
# Optional: if unset, the route falls back to Innertube WEB client.
SUPADATA_API_KEY=sd_your_supadata_api_key

# ─── Admin allowlist ────────────────────────────────────────────────────────
# Comma-separated emails granted admin role at session time (bypasses DB role).
# Useful for bootstrapping the first admin without a DB write.
ADMIN_EMAILS=you@example.com

# ─── Enrichment (Anthropic) ──────────────────────────────────────────────────
# ENRICH_SECRET protects all admin API routes. Generate: openssl rand -hex 24
ENRICH_SECRET=generate_with_openssl_rand_hex_24
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ENRICHMENT_MODEL=claude-haiku-4-5-20251001
ENRICHMENT_BATCH_SIZE=10

# Oracle model — set this explicitly. The code falls back to claude-opus-4-5 if unset,
# which is expensive. Use haiku locally; use opus or sonnet in production.
ORACLE_MODEL=claude-haiku-4-5-20251001

# ─── Auth (NextAuth + Google OAuth) ──────────────────────────────────────────
# NEXTAUTH_URL must match the deployed origin (https://cultcodex.me in prod).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ─── Stripe (two-tier subscription: Codex Access $9, Full System $29) ────────
# Server-side key from the Stripe dashboard. Use a test key (sk_test_…) in
# development, a live key (sk_live_…) in production.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Price IDs for each tier — create two recurring monthly products in Stripe
# and paste the price_… id for each one here.
STRIPE_PRICE_ACCESS_ID=price_your_codex_access_price_id   # $9/mo  — Codex Access
STRIPE_PRICE_SYSTEM_ID=price_your_full_system_price_id    # $29/mo — Full System

# Legacy single-tier price id used by the pre-existing /subscribe flow.
# Keep it set so back-compat checkout calls (no tier in body) keep working.
# If you're a clean install, point this at the same price as STRIPE_PRICE_ACCESS_ID.
STRIPE_PRICE_ID=price_your_legacy_price_id

# Webhook signing secret from `stripe listen` (dev) or the Stripe dashboard
# endpoint config (prod). Required for /api/stripe/webhook signature checks.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key

# ─── Live toggle & web push (optional) ───────────────────────────────────────
LIVE_TOGGLE_SECRET=generate_a_random_secret
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ─── Error monitoring (Sentry) ───────────────────────────────────────────────
# Create a project at sentry.io → Settings → Projects → DSN.
# NEXT_PUBLIC_ prefix exposes it to the browser client for JS error capture.
# SENTRY_AUTH_TOKEN is only needed to upload source maps (optional).
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@o0.ingest.sentry.io/0
SENTRY_DSN=https://your-dsn@o0.ingest.sentry.io/0
# SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ─── Psychenomicon art pipeline (local CLI only) ───────────────────────────
# Keep the real key in your shell or untracked .env.local; never commit it.
HCNSEC_API_KEY=your_hcnsec_api_key
ART_API_BASE_URL=https://api.hcnsec.cn/v1
ART_TEXT_MODEL=DeepSeek-V4-Flash
ART_IMAGE_MODEL=step-image-edit-2
ART_IMAGE_SIZE=1024x1024
ART_IMAGE_DELAY_MS=12000
