// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────

enum ContentStatus {
  draft
  published
  archived
  unavailable
}

enum PersonType {
  guest
  host
  mentioned
  recurring
}

enum CanonStatus {
  canonical
  speculative
  community_myth
  disputed
  humorous
}

enum SeriesType {
  music_video
  panel
  tarot
  story
  documentary
  other
}

enum MediaType {
  video
  audio
  article
}

enum ContentType {
  livestream
  original
  short
  clip
}

// ─── Trollopedia: Evidence + Relationship Engine ─────

enum RelationType {
  friend
  former_friend
  ally
  frequent_collaborator
  debate_rival
  enemy
  occasional_guest
  moderator
  supporter
  critic
  student
  mentor
  community_member
  unknown
}

enum EvidenceSourceType {
  youtube_video
  livestream_transcript
  chat_log
  video_description
  comment
  screenshot
  community_submission
  archived_social_media
  other
}

enum ConfidenceLevel {
  confirmed
  strong
  moderate
  weak
  rumor
}

enum ClaimNature {
  documented
  opinion
  satire
  rumor
  disputed
}

// ─── Core Models ─────────────────────────────────────

model Episode {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  episodeNumber   Int?          @unique
  airDate         DateTime?
  duration        String?
  youtubeVideoId  String?
  rumbleVideoId   String?
  thumbnailUrl    String?
  summaryShort    String?
  summaryLong     String?
  /** Transcript-grounded recap: what happened, who appeared, notable moments with timestamps */
  summaryFacts    String?
  /** AI interpretive layer: recurring patterns, thematic significance, arc context */
  summaryThemes   String?
  cutOfPsyche     String?
  transcriptRaw   String?
  transcriptHtml  String?
  transcriptJson  Json?
  decodeData      Json?
  searchText      String?
  status          ContentStatus @default(draft)
  contentType     ContentType   @default(original)
  seriesId        String?
  /** Set by an admin after manually reading and verifying the AI summary */
  isHumanReviewed Boolean       @default(false)
  humanReviewedAt DateTime?
  /** Manually queued by admin for (re-)enrichment even if summaryLong already exists */
  enrichmentQueued Boolean      @default(false)
  series          Series?       @relation(fields: [seriesId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  segments           TranscriptSegment[]
  quotes             Quote[]
  guests             EpisodeGuest[]
  mentionedPeople    EpisodeMentionedPerson[]
  loreEntries        EpisodeLore[]
  topics             EpisodeTopic[]
  relatedFrom        RelatedEpisode[]  @relation("relatedFrom")
  relatedTo          RelatedEpisode[]  @relation("relatedTo")
  firstAppearanceOf  Person[]          @relation("firstAppearance")
  firstMentionOf     LoreEntry[]       @relation("firstMention")
  reactions          EpisodeReaction[]
  comments           CodexComment[]
  favorites          Favorite[]
  psychenomiconChapter PsychenomiconChapter?
  transcriptRequests TranscriptRequest[]
  evidence           Evidence[]
  relationshipEvents RelationshipEvent[]
  timelineEvents     TimelineEvent[]

  @@index([airDate])
  @@index([status])
  @@index([episodeNumber])
  @@index([seriesId])
  @@index([airDate, status])
}

model Series {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String?
  type          SeriesType    @default(other)
  coverImageUrl String?
  sortOrder     Int           @default(0)
  status        ContentStatus @default(draft)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  episodes   Episode[]
  mediaItems MediaItem[]
}

model Person {
  id                       String     @id @default(cuid())
  displayName              String
  slug                     String     @unique
  altNames                 String[]
  shortBio                 String?
  loreSummary              String?
  avatarUrl                String?
  youtubeChannelUrl        String?
  personType               PersonType @default(guest)
  searchText               String?
  firstAppearanceEpisodeId String?
  firstAppearanceEpisode   Episode?   @relation("firstAppearance", fields: [firstAppearanceEpisodeId], references: [id])
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  // Relations
  quotes             Quote[]
  guestAppearances   EpisodeGuest[]
  mentions           EpisodeMentionedPerson[]
  topics             PersonTopic[]
  loreConnections    PersonLore[]
  relatedFrom        RelatedPerson[] @relation("relatedPersonFrom")
  relatedTo          RelatedPerson[] @relation("relatedPersonTo")
  relationshipEventsFrom RelationshipEvent[] @relation("relationshipEventsFrom")
  relationshipEventsTo   RelationshipEvent[] @relation("relationshipEventsTo")

  @@index([personType])
  @@index([displayName])
}

model LoreEntry {
  id                    String      @id @default(cuid())
  title                 String
  slug                  String      @unique
  category              String?
  summary               String?
  fullEntry             String?
  canonStatus           CanonStatus @default(speculative)
  searchText            String?
  firstMentionEpisodeId String?
  firstMentionEpisode   Episode?    @relation("firstMention", fields: [firstMentionEpisodeId], references: [id])
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  episodes        EpisodeLore[]
  people          PersonLore[]
  topics          LoreTopic[]
  relatedFrom     RelatedLore[] @relation("relatedLoreFrom")
  relatedTo       RelatedLore[] @relation("relatedLoreTo")

  @@index([canonStatus])
  @@index([title])
}

model Topic {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  episodes  EpisodeTopic[]
  people    PersonTopic[]
  lore      LoreTopic[]
  savedBy   SavedTopic[]

  @@index([title])
}

model Quote {
  id                   String             @id @default(cuid())
  text                 String
  speakerPersonId      String?
  speaker              Person?            @relation(fields: [speakerPersonId], references: [id])
  episodeId            String?
  episode              Episode?           @relation(fields: [episodeId], references: [id])
  transcriptSegmentId  String?
  transcriptSegment    TranscriptSegment? @relation(fields: [transcriptSegmentId], references: [id])
  timestampSeconds     Int?
  context              String?
  significance         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  savedBy        SavedQuote[]
  quoteReactions QuoteReaction[]

  @@index([speakerPersonId])
  @@index([episodeId])
  @@index([createdAt])
}

model TranscriptSegment {
  id           String   @id @default(cuid())
  episodeId    String
  episode      Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  startSeconds Int
  endSeconds   Int
  speakerLabel String?
  text         String
  searchText   String?
  // pgvector embedding column — exists in the DB via the 20260517000000_add_pgvector
  // raw migration; declared here so Prisma's schema matches the live database and
  // `prisma migrate diff` stops wanting to drop it. Written/queried only through
  // raw SQL in src/lib/queries/semantic.ts and src/app/api/admin/embed/route.ts.
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotes Quote[]

  // Natural key. Every ingest path (Vercel cron, GitHub Actions, the Windows
  // whisper daemon, the admin API) does check-then-insert and they overlap in
  // time; the `skipDuplicates` / ON CONFLICT DO NOTHING they all use is a no-op
  // without this. Dedupe (scripts/maintenance/dedupe-transcript-segments.ts)
  // before applying the migration that creates it.
  @@unique([episodeId, startSeconds, endSeconds, text])
  @@index([episodeId])
  @@index([startSeconds])
}

model MediaItem {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  type            MediaType     @default(video)
  youtubeVideoId  String?
  transcriptRaw   String?
  summary         String?
  seriesId        String?
  series          Series?       @relation(fields: [seriesId], references: [id])
  releaseDate     DateTime?
  durationSeconds Int?
  status          ContentStatus @default(draft)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([seriesId])
}

// ─── Join Tables ─────────────────────────────────────

model EpisodeGuest {
  episodeId String
  personId  String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([episodeId, personId])
}

model EpisodeMentionedPerson {
  episodeId String
  personId  String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([episodeId, personId])
}

model EpisodeLore {
  episodeId   String
  loreEntryId String
  episode     Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  loreEntry   LoreEntry @relation(fields: [loreEntryId], references: [id], onDelete: Cascade)

  @@id([episodeId, loreEntryId])
}

model EpisodeTopic {
  episodeId String
  topicId   String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([episodeId, topicId])
}

model PersonTopic {
  personId String
  topicId  String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  topic    Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([personId, topicId])
}

model PersonLore {
  personId    String
  loreEntryId String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  loreEntry   LoreEntry @relation(fields: [loreEntryId], references: [id], onDelete: Cascade)

  @@id([personId, loreEntryId])
}

model LoreTopic {
  loreEntryId String
  topicId     String
  loreEntry   LoreEntry @relation(fields: [loreEntryId], references: [id], onDelete: Cascade)
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([loreEntryId, topicId])
}

model RelatedEpisode {
  episodeAId String
  episodeBId String
  episodeA   Episode @relation("relatedFrom", fields: [episodeAId], references: [id], onDelete: Cascade)
  episodeB   Episode @relation("relatedTo", fields: [episodeBId], references: [id], onDelete: Cascade)

  @@id([episodeAId, episodeBId])
}

/// A cited claim: the atomic unit of Trollopedia canon. Every dossier fact,
/// relationship beat, and timeline event points at one of these.
model Evidence {
  id               String             @id @default(cuid())
  claim            String
  nature           ClaimNature        @default(documented)
  confidence       ConfidenceLevel    @default(moderate)
  sourceType       EvidenceSourceType
  sourceUrl        String?
  episodeId        String?
  episode          Episode?           @relation(fields: [episodeId], references: [id])
  timestampSeconds Int?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  relationshipEvents RelationshipEvent[]
  timelineEvents     TimelineEvent[]

  @@index([episodeId])
  @@index([confidence])
  @@index([nature])
}

/// One beat in an evolving relationship between two people. Current state is
/// derived from the latest event per pair; pairs are normalized personAId < personBId.
model RelationshipEvent {
  id           String       @id @default(cuid())
  personAId    String
  personBId    String
  personA      Person       @relation("relationshipEventsFrom", fields: [personAId], references: [id], onDelete: Cascade)
  personB      Person       @relation("relationshipEventsTo", fields: [personBId], references: [id], onDelete: Cascade)
  relationType RelationType @default(unknown)
  headline     String
  details      String?
  episodeId    String?
  episode      Episode?     @relation(fields: [episodeId], references: [id])
  occurredAt   DateTime?
  evidenceId   String?
  evidence     Evidence?    @relation(fields: [evidenceId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([personAId, personBId])
  @@index([episodeId])
  @@index([relationType])
}

/// A dated event in the Psycheverse chronological history.
model TimelineEvent {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  date        DateTime
  category    String?
  description String?
  episodeId   String?
  episode     Episode?      @relation(fields: [episodeId], references: [id])
  evidenceId  String?
  evidence    Evidence?     @relation(fields: [evidenceId], references: [id])
  status      ContentStatus @default(published)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([date])
  @@index([category])
}

model RelatedPerson {
  personAId String
  personBId String
  personA   Person @relation("relatedPersonFrom", fields: [personAId], references: [id], onDelete: Cascade)
  personB   Person @relation("relatedPersonTo", fields: [personBId], references: [id], onDelete: Cascade)

  @@id([personAId, personBId])
}

model RelatedLore {
  loreAId String
  loreBId String
  loreA   LoreEntry @relation("relatedLoreFrom", fields: [loreAId], references: [id], onDelete: Cascade)
  loreB   LoreEntry @relation("relatedLoreTo", fields: [loreBId], references: [id], onDelete: Cascade)

  @@id([loreAId, loreBId])
}

// ─── Live Stream ────────────────────────────────────

model LiveStatus {
  id        String    @id @default("singleton")
  isLive    Boolean   @default(false)
  videoId   String?
  title     String?
  startedAt DateTime?
  endedAt   DateTime?
  updatedAt DateTime  @updatedAt
}

model Subscriber {
  id               String   @id @default(cuid())
  email            String?  @unique
  name             String?
  source           String?
  giftStage        Int      @default(0)
  lastEmailAt      DateTime?
  pushSubscription Json?
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([email])
  @@index([giftStage])
}

model TranscriptRequest {
  id          String   @id @default(cuid())
  episodeId   String
  email       String
  createdAt   DateTime @default(now())
  notifiedAt  DateTime?

  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, email])
  @@index([episodeId])
  @@index([email])
}

// ─── Auth & Community ──────────────────────────────

enum CodexUserRole {
  user
  moderator
  admin
}

enum ReactionType {
  fire
  eye
  moon
  skull
  wildcard
}

model CodexUser {
  id          String        @id @default(cuid())
  email       String        @unique
  displayName String
  avatarUrl   String?
  provider    String
  role        CodexUserRole @default(user)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  stripeCustomerId        String?   @unique
  subscriptionId          String?   @unique
  subscriptionStatus      String?   // "active", "past_due", "canceled", "unpaid"
  subscriptionTier        String?   // "access" | "system"
  currentPeriodEnd        DateTime?
  isLifetimeMember    Boolean   @default(false)

  // Member identity
  memberTitle             String?   // chosen flair title e.g. "Oracle", "Acolyte"
  isPublicMember          Boolean   @default(false) // opt-in to public Member Roll

  // Onboarding
  handle                  String?   @unique
  sigilGlyph              String?
  onboardingCompleted     Boolean   @default(false)
  userArchetype           String?   // archetype slug e.g. "oracle", "alchemist"

  // Personal codex page (system tier)
  bio                     String?
  codexSlug               String?   @unique
  codexPagePublic         Boolean   @default(true)
  codexBanner             String?   // gradient preset: void|crimson|emerald|gold|violet|aurora|abyss|frost
  codexLinks              Json?     // [{label: string, url: string}][] up to 5
  codexShowCards          Boolean   @default(false)

  reactions               EpisodeReaction[]
  comments                CodexComment[]
  reports                 CommentReport[]
  sessions                CodexSession[]
  accounts                CodexAccount[]
  chatMessages            ChatMessage[]
  notificationPreference  NotificationPreference?
  favorites               Favorite[]
  savedTopics             SavedTopic[]
  savedQuotes             SavedQuote[]
  savedSearches           SavedSearch[]
  ownedCards              OwnedCard[]
  wallet                  UserWallet?
  packPurchases           PackPurchase[]
  quoteReactions          QuoteReaction[]
  salonPosts              SalonPost[]
  decks                   Deck[]
  signalProposals         SignalProposal[]
  signalProposalVotes     SignalProposalVote[]
  annotations             Annotation[]
}

model CodexSession {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  user         CodexUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model CodexAccount {
  id                String    @id @default(cuid())
  userId            String
  user              CodexUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  access_token      String?
  refresh_token     String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EpisodeReaction {
  userId       String
  episodeId    String
  reactionType ReactionType
  user         CodexUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode      Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@id([userId, episodeId, reactionType])
  @@index([episodeId])
}

model CodexComment {
  id            String         @id @default(cuid())
  content       String
  userId        String
  user          CodexUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId     String
  episode       Episode        @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        CodexComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       CodexComment[] @relation("CommentReplies")
  flagged       Boolean        @default(false)
  flaggedReason String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  reports       CommentReport[]

  @@index([episodeId])
  @@index([userId])
  @@index([parentId])
}

model CommentReport {
  id        String       @id @default(cuid())
  commentId String
  comment   CodexComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      CodexUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  createdAt DateTime     @default(now())

  @@unique([commentId, userId])
}

// ─── Salon (Oracle-tier members space) ─────────────

/// A discussion prompt/topic in the Salon. Authored by staff (admin).
model SalonThread {
  id        String      @id @default(cuid())
  title     String
  prompt    String      @db.Text
  pinned    Boolean     @default(false)
  closed    Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  posts     SalonPost[]

  @@index([pinned, createdAt])
}

/// A member contribution within a Salon thread.
model SalonPost {
  id            String      @id @default(cuid())
  threadId      String
  thread        SalonThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId        String
  user          CodexUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       String      @db.Text
  flagged       Boolean     @default(false)
  flaggedReason String?
  createdAt     DateTime    @default(now())

  @@index([threadId, createdAt])
  @@index([userId])
}

// ─── Chat & Notifications ─────────────────────────

model ChatMessage {
  id               String    @id @default(cuid())
  userId           String
  user             CodexUser @relation(fields: [userId], references: [id])
  displayName      String
  avatarUrl        String?
  content          String
  flagged          Boolean   @default(false)
  moderationReason String?
  createdAt        DateTime  @default(now())

  @@index([createdAt])
}

model NotificationPreference {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            CodexUser @relation(fields: [userId], references: [id])
  emailNewEpisode Boolean   @default(false)
  emailGoLive     Boolean   @default(false)
  pushGoLive      Boolean   @default(false)
  updatedAt       DateTime  @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      CodexUser @relation(fields: [userId], references: [id])
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, episodeId])
  @@index([userId])
}

// ─── Personal /codex layer ────────────────────────
//
// SavedTopic and SavedQuote are the signed-in user's personal pins of
// signals and moments. Episode saves continue to live on Favorite for
// back-compat with /favorites and the existing FavoriteButton API.
//
// Together these three tables back the /codex dashboard and the
// per-entity "Save" buttons (topics, quotes, episodes).

model SavedTopic {
  id        String    @id @default(cuid())
  userId    String
  user      CodexUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
}

model SavedQuote {
  id        String    @id @default(cuid())
  userId    String
  user      CodexUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  quoteId   String
  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, quoteId])
  @@index([userId])
  @@index([quoteId])
}

// ─── Psychenomicon ────────────────────────────────

model PsychenomiconChapter {
  id             String   @id @default(cuid())
  chapterNumber  Int      @unique
  title          String
  slug           String   @unique
  episodeId      String?  @unique
  episode        Episode? @relation(fields: [episodeId], references: [id])

  canonText          String  @db.Text
  interpretationText String  @db.Text
  mythicText         String  @db.Text
  emergingSignals    String[]

  // JSON blobs for archetypes, entity snapshots, and thread refs
  archetypesData Json?
  threadRefs     Json?
  isMajorEvent   Boolean @default(false)
  status         String  @default("stable") // stable | contested | evolving

  // AI-generated art — Supabase Storage public URLs, set by the art pipeline
  // Shape: { cover, scene_01, scene_02, scene_03 }
  artImageUrls   Json?
  artGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entityAppearances PsychenomiconEntityAppearance[]
  threadChapters    PsychenomiconThreadChapter[]
  archetypeEvents   ArchetypeEvent[]

  @@index([chapterNumber])
}

// Art image bytes stored directly in Postgres (Xata), served by
// /api/psychenomicon-art/[slug]/[slot]. Avoids a separate object store.
model PsychenomiconArtAsset {
  id          String   @id @default(cuid())
  chapterSlug String
  slot        String // cover | scene_01 | scene_02 | scene_03
  mimeType    String   @default("image/jpeg")
  data        Bytes
  createdAt   DateTime @default(now())

  @@unique([chapterSlug, slot])
  @@index([chapterSlug])
}

// A compiled, sellable Psychenomicon book edition (PDF bytes in Postgres).
model BookEdition {
  id          String   @id @default(cuid())
  sku         String   @unique // e.g. "psychenomicon-vol-1"
  title       String
  mimeType    String   @default("application/pdf")
  data        Bytes
  pageCount   Int      @default(0)
  chapterFrom Int      @default(0)
  chapterTo   Int      @default(0)
  generatedAt DateTime @default(now())
}

// One-time purchase entitlement (e.g. a book). Separate from subscriptions.
model BookPurchase {
  id              String   @id @default(cuid())
  userId          String
  sku             String
  stripeSessionId String?
  createdAt       DateTime @default(now())

  @@unique([userId, sku])
  @@index([userId])
}

model PsychenomiconEntity {
  id         String  @id @default(cuid())
  name       String
  slug       String  @unique
  personSlug String? // soft link to Person (no FK — person may not be in DB yet)

  primaryArchetype  String?
  archetypeHistory  Json?    // [{archetype, chapterNumber, reason}]
  radarData         Json?    // {influence, volatility, manipulation, control, emotionalIntensity} 0-10
  behaviorPatterns  String[]
  archetypeState    Json?    // current weighted state: {[archetype]: 0-1}
  status            String   @default("active") // active | dormant | evolved

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appearances      PsychenomiconEntityAppearance[]
  archetypeEvents  ArchetypeEvent[]

  @@index([status])
}

model ArchetypeEvent {
  id                  String  @id @default(cuid())
  entityId            String
  entity              PsychenomiconEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  chapterId           String?
  chapter             PsychenomiconChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  chapterNumber       Int
  primaryArchetype    String
  secondaryArchetypes String[]
  confidenceScore     Float   @default(1.0)
  triggerEvent        String? @db.Text

  createdAt DateTime @default(now())

  @@index([entityId])
  @@index([chapterNumber])
}

model PsychenomiconThread {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String? @db.Text
  status      String  @default("active") // active | resolved | emerging

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapterLinks PsychenomiconThreadChapter[]

  @@index([status])
}

model PsychenomiconEntityAppearance {
  id          String              @id @default(cuid())
  chapterId   String
  entityId    String
  chapter     PsychenomiconChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  entity      PsychenomiconEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  archetypeAt String?
  significance String?

  @@unique([chapterId, entityId])
  @@index([chapterId])
  @@index([entityId])
}

model PsychenomiconThreadChapter {
  chapterId String
  threadId  String
  chapter   PsychenomiconChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  thread    PsychenomiconThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([chapterId, threadId])
}

// ─── Person Media (external content per person) ───────────────────────────────

model PersonMedia {
  id            String    @id @default(cuid())
  personSlug    String
  source        String    // "youtube" | "wiki" | "other"
  sourceId      String?
  sourceUrl     String
  title         String
  description   String?   @db.Text
  thumbnailUrl  String?
  publishedAt   DateTime?
  durationStr   String?
  viewCount     Int?
  rawContent    String?   @db.Text
  channelHandle String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([source, sourceId])
  @@index([personSlug, source])
  @@index([publishedAt])
}

// ─── Community Posts ───────────────────────────────────────────────────────────

model CommunityPost {
  id            String    @id @default(cuid())
  youtubePostId String    @unique
  text          String    @db.Text
  imageUrls     String[]
  likeCount     Int?
  commentCount  Int?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([publishedAt])
}

// ─── Oracle / RAG index ───────────────────────────────────────────────────────

enum OracleChunkSource {
  transcript
  episode_summary
  quote
  lore
  topic
  person
  psy_chapter
  psy_thread
  psy_entity
}

// Legacy model — NOT referenced by any app code (grep oracleChunk in src/ is empty)
// and its table has no migration. The embedder writes 1536-dim vectors, so keep the
// declared type in sync with the real one to avoid a 1024/1536 mismatch if anything
// ever inserts here. Candidates for removal once the schema is baselined.
model OracleChunk {
  id           String              @id @default(cuid())
  sourceType   OracleChunkSource
  sourceId     String
  content      String              @db.Text
  searchText   String              @db.Text
  embedding    Unsupported("vector(1536)")
  metadata     Json
  contentHash  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([sourceType])
  @@index([sourceId])
  @@index([contentHash])
}

model OracleInvite {
  id             String    @id @default(cuid())
  token          String    @unique @default(cuid())
  recipientName  String
  recipientEmail String?
  personalNote   String?   @db.Text
  claimed        Boolean   @default(false)
  claimedAt      DateTime?
  claimedBy      String?
  createdAt      DateTime  @default(now())
}

// ─── Saved Searches ───────────────────────────────────────────────────────────

enum SearchKind {
  simple
  deep
  oracle
}

model SavedSearch {
  id         String     @id @default(cuid())
  userId     String
  user       CodexUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  kind       SearchKind
  query      String     @default("")
  concepts   String[]
  thresholds Float[]
  eraId      String?
  personSlug String?
  archetype  String?
  pinned     Boolean    @default(false)
  lastRunAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

// ─── Quote Reactions ──────────────────────────────────────────────────────────

model QuoteReaction {
  id           String       @id @default(cuid())
  userId       String
  quoteId      String
  reactionType ReactionType
  createdAt    DateTime     @default(now())

  user  CodexUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([userId, quoteId, reactionType])
  @@index([quoteId])
  @@index([userId])
}

// ─── Trading Cards ────────────────────────────────────────────────────────────

enum Rarity {
  STATIC
  SIGNAL
  TRANSMISSION
  ANOMALY
  ORACLE
  LEGENDARY
  MYTHIC
  FORBIDDEN
}

enum CardType {
  VOICE
  TRANSMISSION
  LORE
  SIGNAL
  ORACLE
  CIPHER
  RELIC
  ENTITY
  PROPHECY
  MEMBER
  GLITCH
  MAHAVIDYA
  AVATAR
  INCIDENT
  QUOTE
  EPISODE
  DEITY
  LOCATION
  RITUAL
  SYMBOL
  EVENT
}

model Card {
  id          String    @id @default(cuid())
  slug        String    @unique
  cardType    CardType
  rarity      Rarity
  title       String
  subtitle    String?
  flavourText String?
  artUrl      String?
  statA       Int       @default(50)
  statB       Int       @default(50)
  statC       Int       @default(50)
  abilities   String[]  @default([])
  personality String?
  totalMinted Int       @default(0)
  maxSupply   Int?
  isActive    Boolean   @default(true)

  // ── Divinatory metadata (universal — any card type may participate in a reading) ──
  uprightMeaning     String?  @db.Text
  reversedMeaning    String?  @db.Text
  divinationKeywords String[] @default([])
  element            String?
  planet             String?
  archetype          String?
  shadowAspect       String?  @db.Text
  advice             String?  @db.Text
  oraclePrompt       String?  @db.Text
  meaningVersion     Int      @default(1)
  divinationEligible Boolean  @default(false)
  divinationStrength Int      @default(50)
  oracleCategories   String[] @default([])
  // ── Archive provenance / polymorphic source link ──
  sourceType         String?
  sourceRefId        String?
  mythology          String?
  // ── Codex seasons ──
  // season 0 = legacy archive; 1+ = seasonal Codex sets (catalog in src/lib/cards/codex/).
  // obtainMethod: "pack" | "quest" | "secret" | "signup" — only "pack" cards drop from packs.
  season             Int      @default(0)
  collectorNo        Int?
  obtainMethod       String   @default("pack")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  packCards  PackCard[]
  ownedCards OwnedCard[]
  deckCards  DeckCard[]
  gifts      CardGift[]

  @@index([rarity])
  @@index([cardType])
  @@index([isActive])
  @@index([divinationEligible])
  @@index([sourceType, sourceRefId])
  @@index([mythology])
  @@index([season, obtainMethod])
}

// Single-use gift/claim tokens for hand-distributed card editions (e.g. the
// Founder's Edition drop). Table is created on prod via the idempotent
// `apply-card-gift-migration` data-ops op — same path as subscriber-gift.
model CardGift {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  cardId    String
  serial    Int
  edition   String    @default("founders")
  note      String?
  claimed   Boolean   @default(false)
  claimedAt DateTime?
  claimedBy String?
  createdAt DateTime  @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, edition, serial])
  @@index([cardId])
}

// Daily/monthly LLM spend counters for the global budget breaker
// (src/lib/llm-budget.ts). The table used to be created at runtime with
// `CREATE TABLE IF NOT EXISTS`; it now ships as a real migration so Prisma
// knows about it and the create-on-first-use race is gone.
model LlmBudget {
  bucket_day String @id
  count      Int    @default(0)
}

// Shared fixed-window counters for abuse controls that must hold across every
// serverless instance. One row is reused per endpoint + hashed caller key.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model CardPack {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  description        String?
  cost               Int      @default(100)
  cardCount          Int      @default(5)
  isAvailable        Boolean  @default(true)
  sortOrder          Int      @default(0)
  weightStatic       Float    @default(50)
  weightSignal       Float    @default(30)
  weightTransmission Float    @default(14)
  weightAnomaly      Float    @default(5)
  weightOracle       Float    @default(1)
  weightLegendary    Float    @default(0.5)
  weightMythic       Float    @default(0.1)
  weightForbidden    Float    @default(0.0)
  artTheme           String?
  season             Int      @default(0)
  // Last card of every opening is re-rolled until it reaches this rarity.
  guaranteeRarity    Rarity?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  packCards     PackCard[]
  packPurchases PackPurchase[]
}

model PackCard {
  id     String   @id @default(cuid())
  packId String
  cardId String
  weight Float    @default(1.0)
  pack   CardPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  card   Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([packId, cardId])
  @@index([packId])
}

model OwnedCard {
  id          String   @id @default(cuid())
  userId      String
  cardId      String
  quantity    Int      @default(1)
  isNew       Boolean  @default(true)
  isFoil      Boolean  @default(false)
  obtainedVia String   @default("pack")
  obtainedAt  DateTime @default(now())

  // ── Provenance + evolution ──
  evolutionStage    Int     @default(0)
  source            String  @default("pack")
  method            String?
  serialNumber      Int?
  evolvedFromCardId String?
  firstOwnerId      String?

  user CodexUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, isFoil])
  @@index([userId])
  @@index([cardId])
}

model UserWallet {
  id               String    @id @default(cuid())
  userId           String    @unique
  signalCredits    Int       @default(0)
  balance          Int       @default(0)
  totalEarned      Int       @default(0)
  totalSpent       Int       @default(0)
  lastDailyClaimAt DateTime?
  dailyStreak      Int       @default(0)
  longestStreak    Int       @default(0)
  // ── Daily Signal economy + divination progression (regamify) ──
  signal        Int       @default(0)
  signalResetAt DateTime?
  drawStreak    Int       @default(0)
  lastDrawAt    DateTime?
  xp            Int       @default(0)
  level         Int       @default(1)
  // Free Initiation Pack (one per account) — claimed via an atomic null→now flip.
  initiationClaimedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user         CodexUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
}

model CreditTransaction {
  id          String    @id @default(cuid())
  walletId    String?
  userId      String?
  amount      Int
  reason      String
  referenceId String?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())

  wallet UserWallet? @relation(fields: [walletId], references: [id], onDelete: Cascade)

  // Also: partial unique index "CreditTransaction_purchase_referenceId_key" on
  // (referenceId) WHERE reason = 'purchase' — one grant per Stripe session.
  // Raw SQL in migration 20260924000000_unique_credit_purchase; Prisma can't
  // express it, and a plain @@unique([reason, referenceId]) would break
  // "set_complete" rows, which reuse referenceId (the card type) across users.
  @@index([userId])
  @@index([userId, reason, createdAt])
}

model PackPurchase {
  id           String   @id @default(cuid())
  userId       String
  packId       String
  cardsDrawn   String[]
  creditsCost  Int      @default(0)
  creditsSpent Int      @default(0)
  createdAt    DateTime @default(now())

  user CodexUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack CardPack  @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([packId])
}

// ─── Deck Builder ────────────────────────────────────────────────────────────

model Deck {
  id          String     @id @default(cuid())
  userId      String
  user        CodexUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isPublic    Boolean    @default(false)
  deckCards   DeckCard[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

model DeckCard {
  id     String @id @default(cuid())
  deckId String
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([deckId, cardId])
  @@index([deckId])
}

// ─── Regamify: Reading Persistence, Collections, Divination ──────────────────
// Schema present in the live DB via the orphaned cards_regamify_foundation
// migration; re-declared here so the generated client is typed for the reading
// engine. ReadingCard snapshots meaning at draw time (immutability of history).

model Spread {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  cardCount   Int      @default(1)
  signalCost  Int      @default(1)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  positions SpreadPosition[]
  readings  Reading[]
}

model SpreadPosition {
  id       String  @id @default(cuid())
  spreadId String
  index    Int
  name     String
  meaning  String?
  spread   Spread  @relation(fields: [spreadId], references: [id], onDelete: Cascade)

  @@unique([spreadId, index])
  @@index([spreadId])
}

model Reading {
  id         String   @id @default(cuid())
  userId     String
  spreadId   String?
  question   String?  @db.Text
  seed       String
  reflection String?  @db.Text
  createdAt  DateTime @default(now())

  spread Spread?       @relation(fields: [spreadId], references: [id])
  cards  ReadingCard[]

  @@index([userId, createdAt])
}

model ReadingCard {
  id           String  @id @default(cuid())
  readingId    String
  cardId       String
  position     Int
  positionName String?
  orientation  String
  borrowed     Boolean @default(false)

  drawnMeaningVersion Int
  titleSnapshot       String?
  uprightMeaning      String?  @db.Text
  reversedMeaning     String?  @db.Text
  advice              String?  @db.Text
  oraclePrompt        String?  @db.Text
  keywords            String[] @default([])
  element             String?
  archetype           String?

  reading Reading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@index([readingId])
  @@index([cardId])
}

model CardSet {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  setType          String   @default("tarot")
  mythology        String?
  sortOrder        Int      @default(0)
  rewardCredits    Int      @default(0)
  rewardTitle      String?
  rewardFoilCardId String?
  unlocksSpread    String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members     CardSetMember[]
  completions UserSetCompletion[]

  @@index([setType])
}

model CardSetMember {
  id     String  @id @default(cuid())
  setId  String
  cardId String
  set    CardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, cardId])
  @@index([setId])
  @@index([cardId])
}

model UserSetCompletion {
  id            String   @id @default(cuid())
  userId        String
  setId         String
  completedAt   DateTime @default(now())
  rewardClaimed Boolean  @default(false)
  set           CardSet  @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([userId, setId])
  @@index([userId])
}

model CardInstance {
  id             String   @id @default(cuid())
  cardId         String
  ownerId        String
  firstOwnerId   String?
  serialNumber   Int?
  isFoil         Boolean  @default(false)
  evolutionStage Int      @default(0)
  source         String   @default("pack")
  method         String?
  evolvedFromId  String?
  obtainedAt     DateTime @default(now())

  @@index([ownerId])
  @@index([cardId])
}

model OracleAffinity {
  id                String   @id @default(cuid())
  userId            String   @unique
  dominantElement   String?
  dominantPlanet    String?
  dominantArchetype String?
  mostDrawnSuit     String?
  shadowPattern     String?
  recurringCards    Json     @default("[]")
  readingsCount     Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model SeasonalEvent {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  startsAt     DateTime
  endsAt       DateTime
  rewardCardId String?
  badge        String?
  collectGoal  Json     @default("[]")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([isActive, startsAt, endsAt])
}

// ─── Signal Proposals ────────────────────────────────────
// Oracle-tier members propose what gets investigated next.
model SignalProposal {
  id        String   @id @default(cuid())
  userId    String
  user      CodexUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String   @db.Text
  context   String?  @db.Text
  status    String   @default("open")   // open | under_review | investigating | published | declined
  votes     Int      @default(1) // the author's implicit vote + one per SignalProposalVote
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  voters SignalProposalVote[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// One row per (proposal, voter): the primary key is what stops repeat votes.
model SignalProposalVote {
  proposalId String
  userId     String
  createdAt  DateTime @default(now())

  proposal SignalProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     CodexUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([proposalId, userId])
  @@index([userId])
}

// ─── Stripe Webhook Event Deduplication ───────────────
// Records processed Stripe event IDs so retried webhooks are no-oped.
// Rows expire naturally — Stripe event IDs are globally unique.
model StripeWebhookEvent {
  id          String   @id          // Stripe event id (evt_…)
  type        String                // event type, e.g. "checkout.session.completed"
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ─── Weekly Digest ────────────────────────────────────
// Admin-curated "This week in the archive" selections.
// quoteIds / episodeIds / personIds are arrays of DB IDs
// that the public /this-week page resolves at render time.
model WeeklyDigest {
  id         String   @id @default(cuid())
  weekOf     DateTime @unique
  title      String
  blurb      String?
  published  Boolean  @default(false)
  quoteIds   String[]
  episodeIds String[]
  personIds  String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([weekOf])
}

// ─── Community Annotations ─────────────────────────────
// Member-submitted notes/connections on archive entities. Submitted by
// subscribers, displayed publicly once approved. Moderated at
// /admin/annotations. targetId is the entity SLUG (stable, URL-aligned).
model Annotation {
  id         String   @id @default(cuid())
  userId     String
  user       CodexUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String   // "episode" | "lore" | "person" | "topic"
  targetId   String   // slug of the target entity
  body       String   @db.Text
  status     String   @default("pending") // pending | approved | hidden
  votes      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([targetType, targetId, status])
  @@index([userId])
  @@index([status])
}

// ─── Game Show Leaderboard ─────────────────────────────
// A submitted run from the Panelverse Game Show. Anonymous handle by default;
// optional soft link to a CodexUser. Read for weekly/monthly/all-time boards.
model GameScore {
  id        String   @id @default(cuid())
  handle    String   // display name chosen by the player (or user displayName)
  userId    String?  // optional; no FK — anonymous runs allowed
  score     Int      // headline metric (correct answers in the run)
  correct   Int
  total     Int
  round     String?  // round key or "all"
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([score])
}

// ─── Clap Tokens (#cultofpsyche) ───────────────────────
// A ClapHolder is a nickname on the public /claps board with a permanent
// token total. Each purchase (Stripe checkout or manual CashApp credit via
// admin) appends a ClapToken: the token vests permanently to the holder AND
// grants a 24-hour "clap" spotlight (spotlightUntil). Admin can add/adjust
// at /admin/claps.
model ClapHolder {
  id        String      @id @default(cuid())
  nickname  String      @unique // buyer-chosen display name (case-preserved)
  tokens    Int         @default(0) // denormalized permanent total
  hidden    Boolean     @default(false) // admin can hide a holder from the board
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  claps     ClapToken[]

  @@index([tokens])
  @@index([hidden, tokens])
}

model ClapToken {
  id              String     @id @default(cuid())
  holderId        String
  holder          ClapHolder @relation(fields: [holderId], references: [id], onDelete: Cascade)
  quantity        Int        @default(1)
  source          String     // "stripe" | "cashapp" | "admin"
  amountCents     Int?       // what was actually paid (1000 with coupon, 2000 without); null for admin grants
  couponCode      String?    // e.g. "panel" when the discount applied
  stripeSessionId String?    @unique // idempotency for webhook grants
  note            String?    // admin note (e.g. "cashapp $psyche 07-22")
  spotlightUntil  DateTime?  // 24h clap window from purchase
  createdAt       DateTime   @default(now())

  @@index([holderId])
  @@index([spotlightUntil])
  @@index([createdAt])
}
