{
  "permissions": {
    "allow": [
      "Bash(python3 _system/scripts/vault.py:*)",
      "Bash(obsidian:*)",
      "Bash(date)",
      "Read(**)",
      "Write(_agent/**)",
      "Edit(_agent/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_writes.py\""
          }
        ]
      }
    ]
  }
}
