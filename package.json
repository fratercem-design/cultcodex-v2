{
  "name": "cultcodex-v2-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "build:migrate": "prisma migrate resolve --rolled-back 20260529000001_add_missing_codex_user_fields 2>/dev/null; prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape:youtube": "npx tsx scripts/scrape/fetch-youtube.ts",
    "scrape:transcripts": "npx tsx scripts/scrape/fetch-transcripts.ts",
    "scrape:transform": "npx tsx scripts/scrape/youtube-to-ingest.ts",
    "ingest": "npx tsx scripts/ingest/import-all.ts",
    "ingest:transcripts": "npx tsx scripts/ingest/import-transcripts.ts",
    "ingest:topics": "npx tsx scripts/ingest/import-topics.ts",
    "ingest:people": "npx tsx scripts/ingest/import-people.ts",
    "ingest:lore": "npx tsx scripts/ingest/import-lore.ts",
    "ingest:episodes": "npx tsx scripts/ingest/import-episodes.ts",
    "asr:export": "npx tsx scripts/asr-export-pending.ts",
    "asr:download": "python scripts/asr-download-audio.py --cookies-from-browser chrome",
    "asr:rumble:list": "python scripts/asr-download-rumble.py --list",
    "asr:rumble:preview": "python scripts/asr-download-rumble.py --dry-run",
    "asr:download:rumble": "python scripts/asr-download-rumble.py",
    "asr:transcribe": "python scripts/asr-transcribe.py --backend whisper --whisper-model medium",
    "asr:import": "npx tsx scripts/asr-import-segments.ts",
    "asr:all": "npm run asr:export && npm run asr:download && npm run asr:transcribe && npm run asr:import",
    "enrich:episodes": "npx tsx scripts/enrich/enrich-episodes.ts",
    "enrich:import": "npx tsx scripts/enrich/import-enriched.ts",
    "enrich:topics": "npx dotenvx run -- npx tsx scripts/enrich/enrich-topics.ts",
    "enrich:pipeline": "npx dotenvx run -- npx tsx scripts/enrich/full-pipeline.ts",
    "nightmares:fetch": "npx dotenvx run -- npx tsx scripts/_fetch-psychesnightmares.ts",
    "nightmares:transcripts": "npx tsx scripts/scrape/fetch-transcripts-nightmares.ts",
    "nightmares:enrich": "npx dotenvx run -- npx tsx scripts/enrich/enrich-nightmares.ts",
    "nightmares:enrich:import": "npx dotenvx run -- npx tsx scripts/enrich/import-enriched.ts",
    "nightmares:people": "npx dotenvx run -- npx tsx scripts/enrich/enrich-nightmares-people.ts",
    "nightmares:pipeline": "npm run nightmares:fetch && npm run nightmares:transcripts && npm run nightmares:enrich && npm run nightmares:enrich:import && npm run nightmares:people",
    "art:psychenomicon": "npx dotenvx run -- npx tsx scripts/psychenomicon-art/run.ts",
    "art:psychenomicon:prompts": "npx dotenvx run -- npx tsx scripts/psychenomicon-art/run.ts --skip-images",
    "art:psychenomicon:dry": "npx dotenvx run -- npx tsx scripts/psychenomicon-art/run.ts --dry-run",
    "clean:quotes": "npx dotenvx run -- npx tsx scripts/clean-quotes-grammar.ts",
    "enrich:lore": "npx dotenvx run -- npx tsx scripts/enrich/enrich-lore.ts",
    "clean:descriptions:apply": "npx tsx scripts/clean-episode-descriptions.ts --apply",
    "art:cards": "npx tsx scripts/generate-card-art.ts",
    "art:cards:dry": "npx tsx scripts/generate-card-art.ts --dry-run",
    "art:cards:mahavidya": "npx tsx scripts/generate-card-art.ts --type MAHAVIDYA",
    "art:cards:tarot": "npx tsx scripts/generate-card-art.ts --slug cop-maj-00 --all"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.30.2",
    "@anthropic-ai/sdk": "^0.102.0",
    "@anthropic-ai/bedrock-sdk": "^0.30.1",
    "@anthropic-ai/sdk": "^0.104.1",
    "@auth/prisma-adapter": "^2.11.2",
    "@base-ui/react": "^1.5.0",
    "@next/third-parties": "^16.2.9",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^6.42.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "shadcn": "^4.10.0",
    "stripe": "^22.2.1",
    "shadcn": "^4.11.0",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "ws": "^8.21.0"
  }
}
